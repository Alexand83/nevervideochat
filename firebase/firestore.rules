rules_version = '2';
// NeverVideoChat — Firestore Security Rules (template)
// Copia in Firebase Console → Firestore → Rules, oppure deploy con: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Chiunque può leggere stanze aperte
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null; // In produzione: solo admin (verifica claim o doc profiles)
    }

    // Profili: lettura pubblica, scrittura solo proprio
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Messaggi: lettura pubblica, inserimento da utenti autenticati
    match /messages/{msgId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Temi: lettura pubblica, scrittura solo admin (in produzione legare a profiles.role)
    match /themes/{themeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ruoli personalizzati: lettura pubblica
    match /custom_roles/{roleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Sessioni attive: ogni utente può leggere e scrivere la propria
    match /active_sessions/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ban, kick, mute: lettura pubblica, scrittura solo admin/moderator (da restringere con claim)
    match /banned_users/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /banned_ips/{id} {
      allow read, write: if request.auth != null;
    }
    match /kicked_users/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /muted_users/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Giochi e punteggi
    match /active_games/{id} {
      allow read, write: if true;
    }
    match /game_scores/{id} {
      allow read, write: if true;
    }

    // Admin logs, annunci, segnalazioni, parole filtrate
    match /admin_logs/{id} {
      allow read: if true;
      allow create: if request.auth != null;
    }
    match /announcements/{id} {
      allow read: if resource.data.is_active == true && (resource.data.expires_at == null || resource.data.expires_at > request.time);
      allow write: if request.auth != null;
    }
    match /reported_messages/{id} {
      allow read, write: if request.auth != null;
    }
    match /filtered_words/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
