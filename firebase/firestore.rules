rules_version = '2';
// NeverVideoChat — Firestore Security Rules (template)
// Copia in Firebase Console → Firestore → Rules, oppure deploy con: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function canManagePolls() {
      let profile = get(/databases/$(database)/documents/profiles/$(request.auth.uid));
      return request.auth != null
        && (
          profile.data.role == 'owner'
          || profile.data.role == 'admin'
          || (
            profile.data.custom_role_id != null
            && get(/databases/$(database)/documents/custom_roles/$(profile.data.custom_role_id)).data.permissions.can_manage_polls == true
          )
        );
    }

    function pollIsActiveAndNotExpired(pollId) {
      return exists(/databases/$(database)/documents/polls/$(pollId))
        && get(/databases/$(database)/documents/polls/$(pollId)).data.is_active == true
        && get(/databases/$(database)/documents/polls/$(pollId)).data.cancelled_at == null
        && get(/databases/$(database)/documents/polls/$(pollId)).data.expires_at > request.time;
    }

    // Stanze: lettura pubblica. Create senza auth solo per 'general' (setup-firebase.html)
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if roomId == 'general' || request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Profili: lettura pubblica, scrittura solo proprio
    match /profiles/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Messaggi: lettura pubblica, inserimento da utenti autenticati
    match /messages/{msgId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Temi: lettura pubblica. Create senza auth solo per i 4 temi default (setup-firebase.html)
    match /themes/{themeId} {
      allow read: if true;
      allow create: if themeId in ['dark', 'light', 'blue', 'purple'] || request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Ruoli: lettura pubblica. Create senza auth solo per i 5 ruoli default (setup-firebase.html)
    match /custom_roles/{roleId} {
      allow read: if true;
      allow create: if roleId in ['owner', 'admin', 'moderator', 'user', 'guest'] || request.auth != null;
      allow update, delete: if request.auth != null;
    }

    // Sessioni attive: ogni utente può leggere e scrivere la propria
    match /active_sessions/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ban, kick, mute: lettura pubblica, scrittura solo admin/moderator (da restringere con claim)
    match /banned_users/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /banned_ips/{id} {
      allow read, write: if request.auth != null;
    }
    match /kicked_users/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /muted_users/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Giochi e punteggi
    match /active_games/{id} {
      allow read, write: if true;
    }
    match /game_scores/{id} {
      allow read, write: if true;
    }

    // Configurazione server (TURN, ecc.): lettura da utenti autenticati.
    // Scrittura owner: config/moderation, config/chat_antispam (Admin → General).
    // Le altre config (es. TURN) si scrivono solo da Firebase Console / Admin SDK.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && docId in ['moderation', 'chat_antispam']
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'owner';
      allow delete: if false;
    }

    // Admin logs, annunci, segnalazioni, parole filtrate
    match /admin_logs/{id} {
      allow read: if true;
      allow create: if request.auth != null;
    }
    match /announcements/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reported_messages/{id} {
      allow read, write: if request.auth != null;
    }
    match /filtered_words/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Polls / Sondaggi
    match /polls/{pollId} {
      allow read: if true;
      allow create, update, delete: if canManagePolls();
    }

    match /polls/{pollId}/votes/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && pollIsActiveAndNotExpired(pollId)
        && !exists(/databases/$(database)/documents/polls/$(pollId)/votes/$(userId));
      allow update, delete: if false;
    }
  }
}
